# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Used by local (non-Docker) runs
LANGFUSE_BASE_URL=http://localhost:3000
# Optional: Langfuse URL as seen from inside the agent container
# LANGFUSE_DOCKER_BASE_URL=http://host.docker.internal:3000
# Optional: Grafana host port / admin password
# GRAFANA_PORT=3001
# GRAFANA_PASSWORD=
